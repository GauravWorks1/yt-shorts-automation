# ==============================================================================
# YouTube Shorts Automation Environment Variables
# Rename this file to .env and fill in your API credentials.
# ==============================================================================

# Google Gemini / Flow / Veo Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_FLOW_ENDPOINT=https://your-flow-webhook-or-endpoint.com/generate
GOOGLE_FLOW_API_KEY=your_google_flow_api_key

# ElevenLabs Voiceover Settings
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Default Narrator Voice (Adam: pNInz6obpgDQGcFmaJgB, Brian: nPczCjzI2devNBz1zQrb)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# YouTube Data API v3 Credentials
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_PICKLE_FILE=token.pickle
YOUTUBE_DEFAULT_PRIVACY=public

# Optional custom FFmpeg path (Leave blank if ffmpeg is in your system PATH)
# Windows example: C:\Users\User\bin\ffmpeg.exe
FFMPEG_PATH=
